# ==============================================================================
# Lelam Auction Platform — Environment Configuration Template
# Copy this file to .env and/or .env.local and populate with your credentials.
# ==============================================================================

# ─── Supabase (Frontend & Client SDK) ─────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Supabase (Backend API & Scraper / Worker Admin) ───────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
STORAGE_BUCKET=auction_documents

# ─── Razorpay Payment Gateway ────────────────────────────────────────────────
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# ─── Transactional Emails & Notifications ─────────────────────────────────────
# Resend API Key (Preferred for transactional delivery)
RESEND_API_KEY=re_your_resend_api_key

# Optional SMTP fallback credentials
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=Lelam Company <no-reply@lelam.co>

# ─── Security & Internal Service Auth ─────────────────────────────────────────
INTERNAL_API_SECRET=your_internal_shared_api_secret_for_cron_and_workers
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
VERCEL_ENV=development

# ─── AI & External Integrations ───────────────────────────────────────────────
VITE_OPENROUTER_API_KEY=
VITE_GOOGLE_CLIENT_ID=
OPENAI_API_KEY=

# ─── Scraper & Asset Worker Daemon Tuning ─────────────────────────────────────
WORKER_BATCH_SIZE=10
WORKER_POLL_INTERVAL_MS=15000
WORKER_MAX_RETRIES=3
ATTACHMENT_DOWNLOAD_TIMEOUT_MS=20000
CATALOG_DOWNLOAD_TIMEOUT_MS=45000
MSTC_BASE_URL=https://www.mstcecommerce.com/auctionhome/mstc
